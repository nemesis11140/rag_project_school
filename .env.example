# 复制为 .env 并填入真实值。.env 已被 .gitignore 忽略，不要提交。
# 真实环境变量优先级高于本文件。

# MySQL（本地）
MYSQL_PASSWORD=your_mysql_password

# Redis（本地 docker）
REDIS_PASSWORD=your_redis_password

# LLM（OpenAI 兼容接口）
LLM_API_KEY=sk-your-key-here

# 可选：切换为 Docker Hub 或阿里 ACR 的完整镜像地址
# APP_IMAGE=zcong11140/rag_project_school:latest
